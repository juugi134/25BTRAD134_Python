# Local development: unset DATABASE_URL for ./scenegraph.db (SQLite).
# For Render/other hosts, configure a managed PostgreSQL connection:
DATABASE_URL=postgresql://db_user:DB_PASSWORD@HOST:5432/scenegraph

# Optional Supabase values used by hosted auth or database integrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional Google Sign-In (Firebase configuration or GOOGLE_CLIENT_ID)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional Twilio Verify phone OTP.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail SMTP Configuration for Email OTP & Password Reset
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_USE_TLS=True
SMTP_FROM="SceneGraph Studio <your_sender@gmail.com>"

# Allowed deployment frontend origins. Do not add paths or use *.
CORS_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io
